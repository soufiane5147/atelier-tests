
{
  "name": "atelier-tests",
  "version": "1.0.0",
  "description": "Atelier pratique - Pyramide de tests sur une API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:int": "jest tests/integration --runInBand",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
